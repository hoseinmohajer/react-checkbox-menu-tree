{
  "name": "react-checkbox-menu-tree",
  "version": "1.1.6",
  "packageManager": "pnpm@10.28.1",
  "description": "React Checkbox Menu Tree is a versatile and customizable tree menu component for React applications.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./dist/react-checkbox-menu-tree.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:lib",
    "build:lib": "vite build --config vite.config.lib.ts && node ./scripts/copy-font-assets.mjs",
    "build:sample": "vite build --config sample/vite.config.ts",
    "dev:sample": "vite --config sample/vite.config.ts",
    "prepublishOnly": "vite build --config vite.config.lib.ts && node ./scripts/copy-font-assets.mjs"
  },
  "dependencies": {
    "scroll-into-view": "^1.16.2"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "styled-components": ">=5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/scroll-into-view": "^1.16.4",
    "@types/styled-components": "5.1.34",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^5.3.6",
    "typescript": "^5.5.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoseinmohajer/checkbox-menu-tree.git"
  },
  "bugs": {
    "url": "https://github.com/hoseinmohajer/checkbox-menu-tree/issues"
  },
  "keywords": [
    "reactjs-checkbox",
    "react-menu-tree",
    "checkbox-menu-tree",
    "menu-tree",
    "nested-object-menu-tree",
    "recursive-menu-tree"
  ],
  "author": "HoseinMohajer",
  "license": "MIT",
  "homepage": "https://hoseinmohajer.github.io/checkbox-menu-tree/",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
